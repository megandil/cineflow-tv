<resources>
    <style name="Theme.CineFlow" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/CineFlowWindowAnimation</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="CineFlowWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/cf_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/cf_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/cf_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/cf_fade_out</item>
    </style>
    <style name="Theme.CineFlow.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:selectableItemBackground">@drawable/player_focus</item>
        <item name="android:selectableItemBackgroundBorderless">@drawable/player_focus</item>
    </style>
</resources>
